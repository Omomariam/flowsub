# Server-side only. Copy to .env.mainnet; never upload this file.
BOTCHAIN_NETWORK=mainnet
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_CONFIRMATIONS=2
BOTCHAIN_LOG_RPC_URL=
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_REVIEWED=false
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
FLOWSUB_ADDRESS=
BLOCKSCOUT_API_URL=https://scan.botchain.ai/api
BLOCKSCOUT_API_KEY=
DEPLOYMENT_MAX_COST_BOT=
KEEPER_MIN_BALANCE_BOT=0.01
KEEPER_MAX_TRANSACTIONS=20
KEEPER_MAX_GAS=5000000
KEEPER_MAX_CHECKS=200
KEEPER_MAX_PLANS=100
KEEPER_MAX_COST_BOT=
# Set only a browser-safe URL (no privileged credentials) before export:mainnet.
PUBLIC_LOG_RPC_URL=
PUBLIC_ENV_OUTPUT=.env.production
